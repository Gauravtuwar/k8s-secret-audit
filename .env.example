# ==============================================================================
# Kubernetes Secret Management & Encryption at Rest Audit Tool — Environment Spec
# ==============================================================================

# 1. DATABASE CONFIGURATION (Render Backend / Local)
# Supabase PostgreSQL connection string.
# NOTE for Render: Use the Supabase Connection Pooler string (Port 6543/5432) for IPv4 compatibility!
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. BACKEND AUTHENTICATION & SECURITY (Render Backend)
# Secret key used for signing session JWTs (minimum 32 random characters)
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-here

# 3. CORS & HOSTING ORIGINS (Render Backend)
# Comma-separated list or JSON array of allowed frontend origins
CORS_ORIGINS=https://k8s-secret-audit.vercel.app,http://localhost:3000,http://localhost:5173

# 4. SERVER BINDING PORT (Render dynamically provides $PORT; default is 8000)
PORT=8000

# 5. FRONTEND PUBLIC API BASE URL (Vercel Frontend Environment Settings)
# Public HTTPS URL of the FastAPI service deployed on Render.
# Both root URL (https://your-service.onrender.com) and API v1 URL (https://your-service.onrender.com/api/v1) are supported.
NEXT_PUBLIC_API_URL=https://your-service.onrender.com
